##### Match CTCF


###### Distribution of %Match CTCF

```{r}
#| fig-height: 3
#| fig-width: 8
#PCT homology
cres_type_ctcf_matchingpct_pooled_plot = cres_type_homology_comparison_dge_legs_stats %>% 
  select(hgnc_symbol, 
         type_human,  ctcf_human, 
         match_cretype, match_ctcf, 
         pct_match_ctcf,
         abs_log2fc_diff, status, inverse_se_mouse, 
         treatment, pathogen) %>% 
  distinct() %>% 
  filter(status != "Not LEG") %>%
  filter(match_cretype == "Same",
         ctcf_human == "CTCF-bound",
         match_ctcf == "Same") %>% 

    ggplot(aes(
    x = status,
    y = pct_match_ctcf,
    color = status,
    fill = status
  )) +
  facet_nested_wrap(~type_human + match_cretype + ctcf_human + match_ctcf, scales = "fixed", nrow = 1) +
    geom_violin(width = 1,
              color = NA,
              # draw_quantiles = c(0.25, 0.5, 0.75),
              ) +
  geom_boxplot(width = 0.2,
               outliers = F,
               alpha = 0) +
    # STATISTICAL TEST LAYER
  stat_compare_means(
    comparisons = list(c("Shared", "Not-shared"),
                       c("Shared", "All genes"),
                       c("Not-shared", "All genes")),
    method = "wilcox.test",
    label = "p.adj", 
    vjust = 1.5,
    label.y.np = "top",
    size = 3, 
    tip.length = 0,
    hide.ns = F
  ) +
    theme_vaxgo() +
  theme(
    legend.position = "top",
    axis.title.x = element_blank(), 
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank()
  ) +
  guides(
    color = "none",
    fill = guide_legend(
      title.position = "left", 
      byrow = TRUE, 
      nrow = 1,
      override.aes = list(shape = 22, alpha = 1, size = 3, linetype = 0)
    )
  )+
  scale_fill_manual(values = colors$comparison) +
  scale_color_manual(values = colors$comparison_color) +
  labs(
    x = "Status",
    y = "%Matching CREs",
    fill = "LEG status"
  ) 


