## Transcription factors
### Import, merge, and summarise data 
Annotate with gene regulation - TF Identify conserved Transcription
Factors (TFs) regulating specific genes in both Humans and Mice

```{r}
#Import ChEA3 ===============================

# Clean and parse the ChEA3 transcription factor–target gene matrix
gene_attribute_chea <- read_tsv(here("tables", "Regulation", "gene_attribute_matrix.txt"))

# Transform the wide ChEA matrix into long format, keeping only positive scores
gene_attribute_chea_clean <- gene_attribute_chea %>%
  rename(gene = Gene) %>%
  pivot_longer(-gene, names_to = "experiment", values_to = "score") %>%
  filter(score > 0) %>%
  arrange(desc(score)) %>%
  # Split the experiment metadata into TF name, PMID, and method/tissue/species
  separate(experiment,
           into = c("tf", "pmid", "method_tissue_species"),
           sep = "-",
           extra = "merge",
           fill = "right") %>%
  # Detect species from the metadata string (HUMAN or MOUSE)
  mutate(across(where(is.character), str_trim),
         species = case_when(str_detect(method_tissue_species, "HUMAN") ~ "Human",
                              str_detect(method_tissue_species, "MOUSE") ~ "Mouse",
                              TRUE ~ method_tissue_species)) %>%
  filter(species %in% c("Human", "Mouse"))

# Count evidence per (gene, TF) pair across species
# For each TF–target pair, count how many PMIDs support it in Human and in Mouse
gene_attribute_tf_count <- gene_attribute_chea_clean %>%
  ungroup() %>%
  select(gene, tf, pmid, species) %>%
  group_by(gene, tf) %>%
  pivot_wider(names_from = "species",
              values_from = "pmid") %>%
  mutate(
    Human_pmids = map_chr(Human, ~ paste(.x, collapse = ", ")),
    Mouse_pmids = map_chr(Mouse, ~ paste(.x, collapse = ", ")),
    Human_pmids_n = map_int(Human, length),
    Mouse_pmids_n = map_int(Mouse, length)
  ) %>%
  select(!c(Human, Mouse)) %>%
  mutate(across(ends_with("pmids"), ~ na_if(.x, ""))) %>%
  # Flag whether this TF regulates this gene in both organisms
  mutate(both = if_else(!is.na(Human_pmids) & !is.na(Mouse_pmids), "TRUE", "FALSE"))

# Save the cross-species TF-target count for downstream analysis
saveRDS(gene_attribute_tf_count,
        file = here("tables", "Regulation", "regulation_gene_tf_count.rds"))


# Summarise table =====================
# Reload the TF-count data and gene DGE stats
gene_attribute_tf_count <- readRDS(file = here("tables", "Regulation", "regulation_gene_tf_count.rds"))

#Get percentages
tf_percentages <- gene_attribute_tf_count %>%
  dplyr::arrange(dplyr::desc(both)) %>%
  dplyr::select(gene, both) %>% 
  dplyr::distinct() %>% 
  janitor::tabyl(gene, both) %>%
  janitor::adorn_percentages("row") %>%
  as.data.frame() %>%
  dplyr::rename(
    pct_tf_unique = `FALSE`,
    pct_tf_shared = `TRUE`
  ) %>% 
  dplyr::mutate(
    pct_tf_unique = round(pct_tf_unique * 100, 2),
    pct_tf_shared = round(pct_tf_shared * 100, 2)
  )

# Compute raw counts table
tf_counts <- gene_attribute_tf_count %>%
  dplyr::arrange(dplyr::desc(both)) %>%
  dplyr::select(gene, both) %>% 
  dplyr::distinct() %>% 
  janitor::tabyl(gene, both) %>%
  as.data.frame() %>%
  dplyr::rename(
    n_tf_unique = `FALSE`,
    n_tf_shared = `TRUE`
  )

# Merge 
gene_tf_shared_unique <- tf_percentages %>%
  dplyr::left_join(tf_counts, by = "gene") %>% 
  mutate(n_tf_total = (n_tf_unique + n_tf_shared))

# Print
print(gene_tf_shared_unique)

#Save
gene_tf_shared_unique %>% 
  saveRDS(file = here("tables", "Regulation", "gene_tf_shared_unique.rds"))

# Join the TF regulation table with the gene alignment quadrants
gene_attribute_tf_count_log2fc_stats <- gene_tf_shared_unique %>%
  inner_join(gene_info_human_log2fc_stats ,
             by = join_by(gene))

```

### Plot Total of TFs by species

Scatterplot of total unique TFs per gene in Human vs Mouse. Points are
coloured by classification (Shared vs All). A diagonal line indicates
equal TF counts between species.

```{r}
#| fig-height: 3
#| fig-width: 6
#Import
#### Annotate with gene expression and LEGs
#TFs
gene_attribute_tf_count <- readRDS(file = here("tables", "Regulation", "regulation_gene_tf_count.rds"))
gene_tf_shared_unique = readRDS(file = here("tables", "Regulation", "gene_tf_shared_unique.rds"))
dge_btm_process_genes_diff_bygene_clean_filtered =  readRDS(file = here("tables", "Functional analysis", "dge_btm_process_genes_diff_bygene_clean_filtered.rds"))
  
  
  # Inner join with cross-species differential expression statistics =============
gene_attribute_tf_count_log2fc_stats <- gene_tf_shared_unique %>%
               rename(hgnc_symbol = gene) %>% 
   #Annotate with gene expression
  inner_join(dge_btm_process_genes_diff_bygene_clean_filtered,
             by = join_by(hgnc_symbol))

gene_attribute_tf_count_log2fc_stats %>% 
  dplyr::count(pathogen, status)

```


```{r}
#| fig-height: 3
#| fig-width: 6
# Compare total unique TF counts per gene between human and mouse
#Plot
# Custom labels for the facet headers
variable_names <- c(
  "pct_tf_shared" = "Shared TFs (%)",
  "n_tf_shared"   = "N of Shared TFs",
  "n_tf_total"    = "Total TFs"
)

gene_attribute_tf_divergence_pooled_plot = gene_attribute_tf_count_log2fc_stats %>% 
  select(hgnc_symbol, pathogen, treatment, status, abs_log2fc_diff, pct_tf_shared, n_tf_total) %>% 
  pivot_longer(
    cols = c(pct_tf_shared, n_tf_total),
    names_to = "variable", 
    values_to = "value"
  ) %>% 
  mutate(variable = fct_relevel(variable, "n_tf_total", "pct_tf_shared")) %>% 
  filter(status %in% c("All genes")) %>%
  
  ggplot(aes(x = value, y = abs_log2fc_diff, 
             color = status, fill = status)) +
  
  # Relabel facets cleanly
  facet_wrap(
    ~variable, 
    scales = "free_x", 
    nrow = 1,
    labeller = labeller(variable = variable_names)
  ) +
  geom_smooth(method = "lm",
              se = T
              ) +
     # 1. TOP SIDE: Boxplot 
  geom_violin(
    mapping = aes(
      x = value,         
      y = 0.2,             
      color = status,
      group = interaction(status, variable),
    ),
    alpha = 0.5,
    width = 0.05,
    linewidth = 0,
    show.legend = T
  ) +
  geom_boxplot(
    mapping = aes(
      x = value,         
      y = 0.2,             
      color = status,
      group = interaction(status, variable),
    ),
    alpha = 0,
    width = 0.05,
    color = "black",
    linewidth = 0.2,
    show.legend = T
  ) +
             #Add correlation stats
  stat_cor( 
    method = "spearman",
    cor.coef.name = "rho", 
    label.y = 0.85,
    label.x = 1,
    size = 3.5, 
    show.legend = F
  ) +
  # Line equation
  stat_regline_equation(
    aes(label = ..eq.label..),
    label.x= 1,   
    label.y = 0.95,     
    size = 3.5
  ) +
  scale_fill_manual(values = colors$comparison) +
  scale_color_manual(values = colors$comparison) +
  scale_y_continuous(expand = c(0.01, 0.01), limits = c(0, 1)) +
  scale_x_continuous(expand = c(0.01, 0.01)) +
  
  labs(
    x = NULL,
    y = "|ΔLog2FC|",
    color = "LEGs",
    fill = "LEGs",
    title = "Pooled gene expression conditions"
  ) +
  theme_vaxgo() +
  theme(
    legend.position = "top",
    strip.text = element_text(size = 10, face = "bold") 
  )

#Print
gene_attribute_tf_divergence_pooled_plot 

# Save
ggsave(gene_attribute_tf_divergence_pooled_plot,
       filename = here("Figures", "all_human_mouse_regulation_tfs_divergence_plots_pooled.png"),
       width = 6, height = 3)
  
```




