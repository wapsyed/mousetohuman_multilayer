```{r}
#| fig-height: 3
#| fig-width: 6
#Plot
# Custom labels for the facet headers
variable_names <- c(
  "pct_tf_shared" = "Shared TFs (%)",
  "n_tf_shared"   = "N of Shared TFs",
  "n_tf_total"    = "Total TFs"
)

gene_attribute_tf_count_legs_pooled_plot = gene_attribute_tf_count_log2fc_stats %>% 
  select(hgnc_symbol, pathogen, treatment, status, abs_log2fc_diff, pct_tf_shared, n_tf_total) %>% 
  distinct() %>% 
  pivot_longer(
    cols = c(pct_tf_shared, n_tf_total),
    names_to = "variable", 
    values_to = "value"
  ) %>% 
  mutate(variable = fct_relevel(variable, "n_tf_total", "pct_tf_shared")) %>% 
  filter(status %in% c("Shared", "Not-shared", "All genes")) %>%
  
  ggplot(aes(x = status, y = value, color = status, fill = status)) +
  
  # Relabel facets cleanly
  facet_wrap(
    ~variable, 
    scales = "free_y", 
    nrow = 1,
    labeller = labeller(variable = variable_names)
  ) +
  
  geom_violin(alpha = 1, 
              width = 1,
              color = NA) +
  
  # Boxplot centered on each status
  geom_boxplot(
    width = 0.3,
    alpha = 1,
    outliers = FALSE
  ) +
    #STAT
  ggpubr::stat_compare_means(
    comparisons = list(c("Shared", "Not-shared"),
                       c("Shared", "All genes")),
    method = "wilcox.test",
    p.adjust.method = "BH",
    label = "p.adj",
    vjust = 1.5,
    hide.ns = T, 
    size = 3, 
    tip.length = 0.01, 
  ) +

  
  scale_fill_manual(values = colors$comparison) +
  scale_color_manual(values = colors$comparison_color) +
  
  labs(
    x = "Status",
    y = NULL, 
    color = "LEGs",
    fill = "LEGs",
    title = "Pooled gene expression conditions"
  ) +
  theme_vaxgo() +
  theme(
    legend.position = "top", axis.ticks.x = element_blank(),
    axis.text.x = element_blank(),
    strip.text = element_text(size = 10) 
  )

