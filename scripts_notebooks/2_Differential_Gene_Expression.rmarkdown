  readRDS(file = here("tables", "Differential gene expression", "trauma_human_log2fc_unpaired_ttest.rds")) %>% 
# Tag rows as Human: required for downstream faceting when combining Mouse and Human results
  mutate(organism = "Human",
         pathogen = "Trauma",
         timepoint = str_replace(timepoints_new, "_", " "),
         timepoint = str_replace(timepoint, "Early Hours", "Early hours")) 

mouse_log2fc_paired_unpaired_ttest_trauma =
