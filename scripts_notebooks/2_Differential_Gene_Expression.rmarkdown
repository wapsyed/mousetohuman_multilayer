  rename(padj = p_adj,
         pval = p_val)


# Merge datasets
all_log2fc_paired_unpaired_ttest = bind_rows(
          human_log2fc_paired_unpaired_ttest_influenza,
          mouse_log2fc_paired_unpaired_ttest_influenza,
          human_log2fc_paired_unpaired_ttest_hepatitisb,
          mouse_log2fc_paired_unpaired_ttest_hepatitisb,
          human_log2fc_paired_unpaired_ttest_saureus,
          mouse_log2fc_paired_unpaired_ttest_saureus,
          human_log2fc_paired_unpaired_ttest_ecoli,
          mouse_log2fc_paired_unpaired_ttest_ecoli,
          human_log2fc_paired_unpaired_ttest_burn,
          mouse_log2fc_paired_unpaired_ttest_burn,
          human_log2fc_paired_unpaired_ttest_trauma,
          mouse_log2fc_paired_unpaired_ttest_trauma)


#Limma
all_degs = readRDS(file = here("tables", "Differential gene expression", "all_human_mouse_dge_limma_degs.rds"))

human_degs = all_degs %>% 
# Standardise column names to snake_case using janitor::clean_names for consistent tidyverse syntax
  clean_names() %>% 
  filter(organism == "Human") %>% 
  rename(padj = adj_p_val) %>% 
  mutate(test = "Limma",
         paired = case_when(pathogen %in% c("Staphylococcus aureus", "Escherichia coli", "Burn", "Trauma") ~ "Unpaired",
                            pathogen %in% c("Influenza", "Hepatitis B") ~ "Paired", 
                            T ~ pathogen)) 

mouse_degs = all_degs %>% 
# Standardise column names to snake_case using janitor::clean_names for consistent tidyverse syntax
  clean_names() %>% 
  filter(organism == "Mouse") %>% 
  rename(padj = adj_p_val) %>% 
# Tag rows as Mouse: required for downstream faceting when combining Mouse and Human results
  mutate(organism = "Mouse",
         test = "Limma",
         paired = case_when(pathogen %in% c("Staphylococcus aureus", "Escherichia coli", "Influenza", "Hepatitis B") ~ "Paired",
                            pathogen %in% c("Burn", "Trauma") ~ "Paired", 
                            T ~ pathogen)) 

#Merge datasets
degs_ttest_limma =
  bind_rows(
    all_log2fc_paired_unpaired_ttest,
    human_degs,
    mouse_degs
    ) %>% 
# Relevel timepoint factor: set baseline (0) as the reference level
  mutate(timepoint = fct_relevel(timepoint, c("Early hours", "2h", "4h", "6h", "12h", "24h", "Day 1", "Day 3", "Day 7")),
         pathogen = as.character(pathogen),
         pathogen = case_when(pathogen == "Staphylococcus aureus" ~ "S. aureus",
                              pathogen == "Hepatitis B" ~ "HepB",
                              pathogen == "Escherichia coli" ~ "E. coli",
                              T ~ pathogen),
          pathogen = fct_relevel(pathogen, "Influenza", "HepB", "S. aureus", "E. coli", "Burn", "Trauma"))

all_log2fc_paired_unpaired_ttest %>% 
  dplyr::count(pathogen, organism, timepoint)

all_degs%>% 
  dplyr::count(pathogen, organism, timepoint, )

```

Summarize DEG counts by method and create a comparison plot across all conditions.
```{r}
#| fig-height: 10
#| fig-width: 12
#Summarize  
degs_ttest_limma_summary = degs_ttest_limma %>% 
  group_by(pathogen, organism, timepoint, test) %>% 
# Count the number of differentially expressed genes (adj.p ≤ 0.05) per comparison
  summarise( n_degs = sum(padj <= 0.05, na.rm = TRUE)) %>% 
  ungroup()

degs_ttest_limma_summary

# Plot number of DEGs per test and significance level
degs_ttest_limma_summary_plot_gg_1row = degs_ttest_limma_summary %>%
  filter(pathogen %in% c("Influenza", "HepB")) %>% 
  ggplot(aes(
    x = timepoint,
    y = n_degs,
    fill = test
  )) +
  facet_wrap(~pathogen~organism, 
                    scales = "free",
                    space = "free_x",
                    # strip = strip_nested(size = "variable"),
                    nrow = 1
             ) +
  geom_col(position = position_dodge2(width = 0.8),
           width = 0.5) +
  scale_fill_manual(values = c(
    "t-Test" = "gray25",
    "Limma" = "#4DBBD5FF"
  )) +
  
  scale_x_discrete(
    expand = c(0.01, 0.01)
  ) +
  scale_y_continuous(expand = c(0, 0), n.breaks = 5) +
  theme_vaxgo() +
  labs(
    title = "Total DEGs by test and timepoint",
    subtitle = "Comparison across tests (FDR ≤ 0.05)",
    x = "Time",
    y = "DEGs",
    fill = "Test",
    alpha = "Pairing"
  ) +
  theme(
    legend.position = "top",
    axis.line.y = element_blank(),
    panel.grid.major.y = element_line(color = "gray75", linetype = 3),
    axis.ticks.y = element_line(color = "gray75"),
    ggh4x.facet.nestline = element_line(colour = "black", linetype = 1)) 

degs_ttest_limma_summary_plot_gg_2row = degs_ttest_limma_summary %>%
  filter((pathogen %in% c("S. aureus", "E. coli"))) %>% 
  ggplot(aes(
    x = timepoint,
    y = n_degs,
    fill = test
  )) +
  facet_wrap(~pathogen~organism, 
                    scales = "free",
                    space = "free_x",
                    # strip = strip_nested(size = "variable"),
                    nrow = 1
             ) +
  geom_col(position = position_dodge2(width = 0.8),
           width = 0.5) +
  scale_fill_manual(values = c(
    "t-Test" = "gray25",
    "Limma" = "#4DBBD5FF"
  )) +
  
  scale_x_discrete(
    expand = c(0.01, 0.01)
  ) +
  scale_y_continuous(expand = c(0, 0), n.breaks = 5) +
  theme_vaxgo() +
  labs(
    x = "Time",
    y = "DEGs",
    fill = "Test",
    alpha = "Pairing"
  ) +
  theme(
    legend.position = "top",
    axis.line.y = element_blank(),
    panel.grid.major.y = element_line(color = "gray75", linetype = 3),
    axis.ticks.y = element_line(color = "gray75"),
    ggh4x.facet.nestline = element_line(colour = "black", linetype = 1)) 

degs_ttest_limma_summary_plot_gg_3row = degs_ttest_limma_summary %>%
  filter((pathogen %in% c("Burn", "Trauma"))) %>% 

    ggplot(aes(
    x = timepoint,
    y = n_degs,
    fill = test
  )) +
  facet_wrap(~pathogen~organism, 
                    scales = "free",
                    space = "free_x",
                    nrow = 1
             ) +
  geom_col(position = position_dodge2(width = 0.8),
           width = 0.5) +
  scale_fill_manual(values = c(
    "t-Test" = "gray25",
    "Limma" = "#4DBBD5FF"
  )) +
  
  scale_x_discrete(
    expand = c(0.01, 0.01)
  ) +
  scale_y_continuous(expand = c(0, 0), n.breaks = 5) +
  
  theme_vaxgo() +
  labs(
    x = "Time",
    y = "DEGs",
    fill = "Test",
    alpha = "Pairing"
  ) +
  theme(
    legend.position = "top",
    axis.line.y = element_blank(),
    panel.grid.major.y = element_line(color = "gray75", linetype = 3),
    axis.ticks.y = element_line(color = "gray75"),
    ggh4x.facet.nestline = element_line(colour = "black", linetype = 1)) 


degs_ttest_limma_summary_plot_gg = (degs_ttest_limma_summary_plot_gg_1row /
degs_ttest_limma_summary_plot_gg_2row/
  degs_ttest_limma_summary_plot_gg_3row) +
  plot_layout(guides = "collect", axes = "collect") +
  plot_annotation(theme = theme(legend.position = "top"))

# Render plot
degs_ttest_limma_summary_plot_gg

degs_ttest_limma_summary_plot_gg %>%
  ggsave(filename = here("Figures", "all_human_mouse_dge_ttest_limma_summary.png"),
         width = 12,
         height = 10)
```







## FIT
Standardize with DGE output.

```{r}
fit_saureus_results = readRDS(file = here("tables", "saureus_mouse_fit_prediction_results_12h.rds"))
fit_ecoli_results = readRDS(file = here("tables", "FIT", "ecoli_mouse_fit_prediction_results_12h.rds"))
fit_fluad_results = readRDS(file = here("tables", "FIT", "influenza_mouse_fit_prediction_results.rds"))
fit_engerixb_results = readRDS(file = here("tables", "hepatitisb_fit_prediction_results_alltimes.rds"))

all_degs_human_mouse = readRDS(here("tables", "Differential gene expression", "all_human_mouse_dge_limma_degs.rds"))

all_fit_results = fit_fluad_results %>% 
  bind_rows(
    fit_fluad_results,
    fit_engerixb_results,
    fit_saureus_results %>% mutate(timepoint = as.character(as.numeric(timepoint)/24)),
    fit_ecoli_results %>% mutate(timepoint = as.character(as.numeric(timepoint)/24))
    ) %>% 
  mutate(organism = case_when(measure == "fit_prediction" ~ "FIT",
                             measure == "mouse_effect_size" ~ "Mouse",
                             T ~ measure),
         timepoint = fct_reorder(timepoint, as.numeric(timepoint))) 

all_fit_results %>% 
# Save R object to disk in native RDS format: preserves data types and structure for fast loading
  saveRDS(here("tables", "FIT", "all_fit_prediction_results.rds"))

#Standardize with DGE output
all_human_mouse_fit = 
  
  all_degs_human_mouse %>% 
  mutate(timepoint = if_else(pathogen %in% c("Staphylococcus aureus",
                                             "Escherichia coli"), 
                             as.character(round((as.numeric(timepoint)/24), 2)), 
                             timepoint)) %>% 
  
  bind_rows(all_fit_results %>% 
              filter(organism == "FIT") %>% 
              select(organism, pathogen, treatment, timepoint, human_symbol, mean_l2fc = value, 
                     ci_lower = ci_low, ci_upper = ci_high)) %>% 
  
  filter(
  #Filter out different times in infection in mice and FIT
  !(pathogen %in% c("Staphylococcus aureus", "Escherichia coli") &
      organism == "Mouse" &
    timepoint %in% c("0.08", "0.17", "0.25", "1")))
all_human_mouse_fit

all_human_mouse_fit %>% 
  filter(pathogen == "Escherichia coli",
         organism == "Mouse") %>% 
  pull(timepoint) %>% unique()

```


Visualize distribution.

```{r}
#| fig-height: 5
#| fig-width: 18
all_human_mouse_fit$timepoint %>% unique()

#Visualize distribution
all_fit_results_histogram = all_human_mouse_fit %>% 
  mutate(pathogen = fct_relevel(pathogen, "Influenza", "Hepatitis B", "Staphylococcus aureus", "Escherichia coli")) %>% 
  ggplot() +
  aes(x = mean_l2fc,
      fill = timepoint) +
  facet_nested_wrap(~pathogen+organism, axes = "x",
               nest_line = element_line(linetype = 1, color = "black", size = 0.5), 
               scales = "free_y", nrow = 2) +
  geom_density(aes(y = after_stat(count),
                   color = timepoint,
                   fill = timepoint),
                  position = position_identity(), 
               alpha = 0,
               size = 1.5,
              show.legend = T) +
  scale_x_continuous(limits = c(-2, 2)) +
  scale_y_continuous(expand = c(0,0)) +
  geom_vline(xintercept = 0, linetype = 2) +
  scale_fill_manual(values =  c("0.08" = "#D0D8FB", 
                                   "0.17" = "#A1B0F7",
                                   "0.5" = "#4361ee",
                                   "1" = "#90e0ef",
                                   "3" = "#0096c7",
                                   "7" = "#184e77")) +
  scale_color_manual(values =  c("0.08" = "#D0D8FB", 
                                   "0.17" = "#A1B0F7",
                                   "0.5" = "#4361ee",
                                   "1" = "#90e0ef",
                                   "3" = "#0096c7",
                                   "7" = "#184e77")) +
  theme_vaxgo() +
  theme(strip.text.y = element_text(angle = 0, hjust = 0), 
        axis.ticks.y = element_blank(),
        legend.position = "top",
        axis.text.x = element_text(size = 8),
        axis.text.y = element_text(size = 8),
        axis.line.y = element_blank(),
        panel.spacing.y = unit(0.3, "lines"),
        panel.grid.major.y = element_blank(),
        panel.grid.major.x = element_line(alpha = 0.5, linetype = 2)
        ) +
  guides(fill = "none") +
  labs(x = "Log2FC",
       y = "Count",
       fill = "Timepoint (Day)",
       color = "Timepoint")

all_fit_results_histogram

all_fit_results_histogram %>% 
  ggsave(filename = here("Figures", "all_human_mouse_fit_results_histogram.png"), 
         width = 16,
         height = 5)
```









